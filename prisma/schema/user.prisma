model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  profileImage String?
  name         String?
  surname      String?
  username     String   @unique
  createdAt    DateTime @default(now())

  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
}
