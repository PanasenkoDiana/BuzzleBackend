model Image {
  id   Int    @id @default(autoincrement())
  name String

  User_Post   User_Post? @relation(fields: [user_PostId], references: [id])
  user_PostId Int?

  User    User? @relation(fields: [user_Id], references: [id])
  user_Id Int?

  Album    Album? @relation(fields: [album_Id], references: [id])
  album_Id Int?
}
